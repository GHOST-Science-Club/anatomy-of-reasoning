{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Bash(cat *.env*)",
      "Bash(cat **/.env*)",
      "Bash(grep * *.env*)",
      "Bash(head * *.env*)",
      "Bash(tail * *.env*)",
      "Bash(less *.env*)",
      "Bash(source *.env*)"
    ]
  }
}
